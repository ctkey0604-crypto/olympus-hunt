{
  // Olympus Hunt: the game files are in public/, the server is src/index.js.
  "name": "olympus-hunt",
  "main": "src/index.js",
  "compatibility_date": "2025-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Multiplayer: one Room object per room (relays messages, never runs the game) and one Lobby holding the public room list.
  "durable_objects": { "bindings": [ { "name": "ROOMS", "class_name": "Room" }, { "name": "LOBBY", "class_name": "Lobby" } ] },
  "migrations": [ { "tag": "v1", "new_sqlite_classes": ["Room", "Lobby"] } ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "olympus-hunt",
      // Paste the Database ID from Cloudflare (Storage & databases > D1 > olympus-hunt) between the quotes:
      "database_id": "a2c40b7d-dcc7-4896-82f3-9e7ceb4f8bd6"
    }
  ]
}
